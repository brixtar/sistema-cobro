ascript +  // Modificar backend/server.js para incluir: +  app.get('/api/clientes', (req, res) => { +      db.all("SELECT * FROM clientes", [], (err, rows) => { +          res.json(rows || []); +      }); +  }); + +  app.post('/api/clientes', (req, res) => { +      const { nombre, telefono, limiteCredito } = req.body; +      db.run("INSERT INTO clientes (nombre, telefono, limiteCredito, saldo) VALUES (?, ?, ?, 0.0)", [nombre, telefono, limiteCredito], function(err) { +          if (err) return res.status(500).json({ error: err.message }); +          res.json({ id: this.lastID, nombre, telefono, limiteCredito, saldo: 0.0 }); +      }); +  }); + +  app.get('/api/inventario', (req, res) => { +      db.all("SELECT * FROM inventario", [], (err, rows) => { +          res.json(rows || []); +      }); +  }); +  ``` + +- [ ] **Step 3: Implementar endpoints de Turnos de Caja (Apertura, Congelaci├â┬│n, Auditor├â┬¡a)** +  ```javascript +  // Modificar backend/server.js para incluir: +  app.get('/api/turnos/activo/:sucursalId', (req, res) => { +      const { sucursalId } = req.params; +      db.get("SELECT * FROM turnos WHERE sucursalId = ? AND estado = 'abierto'", [sucursalId], (err, row) => { +          res.json(row || null); +      }); +  }); + +  app.post('/api/turnos/abrir', (req, res) => { +      const { sucursalId, cajeroNombre, saldoInicial } = req.body; +      db.run(`INSERT INTO turnos (sucursalId, cajeroNombre, inicio, estado, saldoInicial, saldoEfectivoTeorico, saldoVirtualTeorico, saldoTarjetaTeorico)  +              VALUES (?, ?, datetime('now', 'localtime'), 'abierto', ?, ?, 0, 0)`, +             [sucursalId, cajeroNombre, saldoInicial, saldoInicial], function(err) { +          if (err) return res.status(500).json({ error: err.message }); +          res.json({ id: this.lastID, status: 'abierto' }); +      }); +  }); + +  app.post('/api/turnos/congelar', (req, res) => { +      const { id } = req.body; +      db.run("UPDATE turnos SET estado = 'congelado' WHERE id = ?", [id], (err) => { +          if (err) return res.status(500).json({ error: err.message }); +          res.json({ success: true }); +      }); +  }); + +  app.post('/api/turnos/auditar', (req, res) => { +      const { id, saldoEfectivoReal, notes } = req.body; +      db.get("SELECT * FROM turnos WHERE id = ?", [id], (err, turno) => { +          if (!turno) return res.status(404).json({ error: "Turno no encontrado" }); +          const discrepancia = saldoEfectivoReal - turno.saldoEfectivoTeorico; +          db.run(`UPDATE turnos SET fin = datetime('now', 'localtime'), estado = 'auditado',  +                  saldoEfectivoReal = ?, discrepanciaEfectivo = ?, notes = ? WHERE id = ?`, +                 [saldoEfectivoReal, discrepancia, notes, id], (err) => { +              if (err) return res.status(500).json({ error: err.message }); +              res.json({ success: true, discrepancia }); +          }); +      }); +  }); + +  app.get('/api/turnos', (req, res) => { +      db.all("SELECT * FROM turnos ORDER BY id DESC", [], (err, rows) => { +          res.json(rows || []); +      }); +  }); +  ``` + +- [ ] **Step 4: Implementar registro de Ventas e Historial** +  ```javascript +  // Modificar backend/server.js para incluir: +  app.post('/api/ventas', (req, res) => { +      const { sucursalId, turnoId, clienteId, total, metodoPago, items, estado } = req.body; +       +      db.serialize(() => { +          db.run("BEGIN TRANSACTION"); +           +          // Registrar la venta +          db.run(`INSERT INTO ventas (sucursalId, turnoId, fecha, clienteId, clienteNombre, total, metodoPago, estado)  +                  VALUES (?, ?, datetime('now', 'localtime'), ?, (SELECT nombre FROM clientes WHERE id = ?), ?, ?, ?)`, +                 [sucursalId, turnoId, clienteId, clienteId, total, metodoPago, estado || 'cobrado'], function(err) { +              if (err) { +                  db.run("ROLLBACK"); +                  return res.status(500).json({ error: err.message }); +              } +              const ventaId = this.lastID; +               +              // Registrar items +              const stmt = db.prepare("INSERT INTO venta_items (ventaId, productoId, nombre, precio, cantidad) VALUES (?, ?, ?, ?, ?)"); +              items.forEach(item => { +                  stmt.run(ventaId, item.productoId, item.nombre, item.precio, item.cantidad); +              }); +              stmt.finalize(); + +              // Actualizar cuenta corriente si es corriente o pago de deuda +              if (metodoPago === 'corriente') { +                  db.run("UPDATE clientes SET saldo = saldo - ? WHERE id = ?", [total, clienteId]); +              } else if (estado === 'cobro_deuda') { +                  db.run("UPDATE clientes SET saldo = saldo + ? WHERE id = ?", [total, clienteId]); +              } + +              // Actualizar saldos te├â┬│ricos del turno de caja +              if (metodoPago === 'efectivo') { +                  db.run("UPDATE turnos SET saldoEfectivoTeorico = saldoEfectivoTeorico + ? WHERE id = ?", [total, turnoId]); +              } else if (metodoPago === 'virtual') { +                  db.run("UPDATE turnos SET saldoVirtualTeorico = saldoVirtualTeorico + ? WHERE id = ?", [total, turnoId]); +              } else if (metodoPago === 'tarjeta') { +                  db.run("UPDATE turnos SET saldoTarjetaTeorico = saldoTarjetaTeorico + ? WHERE id = ?", [total, turnoId]); +              } + +              db.run("COMMIT", (err) => { +                  if (err) return res.status(500).json({ error: "Transaction commit failed" }); +                  res.json({ success: true, ventaId }); +              }); +          }); +      }); +  }); +  ``` + +- [ ] **Step 5: Validar REST API completa** +  Correr el servidor (`npm start`) y probar con curl una autenticaci├â┬│n v├â┬ílida: +  `curl -X POST http://localhost:5000/api/auth/login -H "Content-Type: application/json" -d "{\"tipo\":\"cajero\",\"nombre\":\"Carlos\",\"pin\":\"1111\"}"` +  Debe retornar: `{"success":true,"user":"Carlos","rol":"cajero","sector":null}`. + +- [ ] **Step 6: Realizar Commit** +  `git add backend/server.js` +  `git commit -m "feat: implement backend REST api controllers for shift audits, auth, sales and clients"` + +--- + + diff --git a/.superpowers/sdd/2026-07-27-migracion-web-sistema/task-2-report.md b/.superpowers/sdd/2026-07-27-migracion-web-sistema/task-2-report.md new file mode 100644 index 0000000..ad10314 --- /dev/null +++ b/.superpowers/sdd/2026-07-27-migracion-web-sistema/task-2-report.md @@ -0,0 +1,31 @@ +# Task 2: Implementaci├│n de Endpoints REST del Backend - Report + +## Changes Made +Implemented the full catalog of REST API endpoints in `backend/server.js`: +- `POST /api/auth/login`: Handles admin passcode validation (`admin123`) and queries the database for cashier/employee pin codes. +- `GET /api/sucursales`: Lists sucursales. +- `GET /api/clientes` & `POST /api/clientes`: Basic client operations. +- `GET /api/inventario`: Returns products from stock catalog. +- `GET /api/turnos/activo/:sucursalId`: Returns currently open shift. +- `POST /api/turnos/abrir`: Creates a new shift. +- `POST /api/turnos/congelar`: Changes state to frozen. +- `POST /api/turnos/auditar`: Closes shift and calculates discrepancies. +- `GET /api/turnos`: Lists historic shifts. +- `POST /api/ventas`: Core billing controller. Wraps updates in a SQL Transaction (BEGIN, COMMIT, ROLLBACK) to deduct/add client balance (Cta. Cte.) and update shift theoretical cash. + +## Verification +Executed automated REST validation script `test_apis.js` with Node: +``` +=== INICIANDO PRUEBAS DE API === +Login Carlos: PASSED { success: true, user: 'Carlos', rol: 'cajero', sector: null } +Login Admin: PASSED { success: true, user: 'admin', rol: 'admin' } +Sucursales: PASSED Count: 2 +Clientes: PASSED Count: 4 +Turno Activo inicial (espera null): PASSED null +Abrir Turno Carlos: PASSED { id: 1, status: 'abierto' } +Registrar Venta: PASSED { success: true, ventaId: 1 } +Congelar Turno: PASSED +Auditar Turno: PASSED Discrepancia: 0 +=== PRUEBAS FINALIZADAS === +``` +All endpoints and transactions function correctly and in alignment with specifications. diff --git a/backend/server.js b/backend/server.js index 614d364..a95921b 100644 --- a/backend/server.js +++ b/backend/server.js @@ -3,14 +3,154 @@ import cors from 'cors';  import { db } from './database.js';    const app = express();  app.use(cors());  app.use(express.json());    app.get('/api/health', (req, res) => {      res.json({ status: 'ok', database: 'connected' });  });   +// Autenticaci├│n por PIN o contrase├▒a maestra +app.post('/api/auth/login', (req, res) => { +    const { tipo, nombre, pin } = req.body; +    if (tipo === 'admin') { +        if (pin === 'admin123') { +            return res.json({ success: true, user: 'admin', rol: 'admin' }); +        } +        return res.status(401).json({ success: false, message: 'Contrase├▒a de administrador incorrecta' }); +    } +     +    const tabla = tipo === 'cajero' ? 'cajeros' : 'empleados'; +    db.get(`SELECT * FROM ${tabla} WHERE nombre = ? AND pin = ?`, [nombre, pin], (err, row) => { +        if (err || !row) { +            return res.status(401).json({ success: false, message: 'Usuario o c├│digo PIN incorrecto' }); +        } +        res.json({ success: true, user: row.nombre, rol: tipo === 'cajero' ? 'cajero' : 'sector', sector: row.sector || null }); +    }); +}); + +// Sucursales +app.get('/api/sucursales', (req, res) => { +    db.all("SELECT * FROM sucursales", [], (err, rows) => { +        res.json(rows || []); +    }); +}); + +// Clientes +app.get('/api/clientes', (req, res) => { +    db.all("SELECT * FROM clientes", [], (err, rows) => { +        res.json(rows || []); +    }); +}); + +app.post('/api/clientes', (req, res) => { +    const { nombre, telefono, limiteCredito } = req.body; +    db.run("INSERT INTO clientes (nombre, telefono, limiteCredito, saldo) VALUES (?, ?, ?, 0.0)", [nombre, telefono, limiteCredito], function(err) { +        if (err) return res.status(500).json({ error: err.message }); +        res.json({ id: this.lastID, nombre, telefono, limiteCredito, saldo: 0.0 }); +    }); +}); + +// Inventario +app.get('/api/inventario', (req, res) => { +    db.all("SELECT * FROM inventario", [], (err, rows) => { +        res.json(rows || []); +    }); +}); + +// Turnos de Caja (Apertura, Cierre, Auditor├¡a) +app.get('/api/turnos/activo/:sucursalId', (req, res) => { +    const { sucursalId } = req.params; +    db.get("SELECT * FROM turnos WHERE sucursalId = ? AND estado = 'abierto'", [sucursalId], (err, row) => { +        res.json(row || null); +    }); +}); + +app.post('/api/turnos/abrir', (req, res) => { +    const { sucursalId, cajeroNombre, saldoInicial } = req.body; +    db.run(`INSERT INTO turnos (sucursalId, cajeroNombre, inicio, estado, saldoInicial, saldoEfectivoTeorico, saldoVirtualTeorico, saldoTarjetaTeorico)  +            VALUES (?, ?, datetime('now', 'localtime'), 'abierto', ?, ?, 0, 0)`, +           [sucursalId, cajeroNombre, saldoInicial, saldoInicial], function(err) { +        if (err) return res.status(500).json({ error: err.message }); +        res.json({ id: this.lastID, status: 'abierto' }); +    }); +}); + +app.post('/api/turnos/congelar', (req, res) => { +    const { id } = req.body; +    db.run("UPDATE turnos SET estado = 'congelado' WHERE id = ?", [id], (err) => { +        if (err) return res.status(500).json({ error: err.message }); +        res.json({ success: true }); +    }); +}); + +app.post('/api/turnos/auditar', (req, res) => { +    const { id, saldoEfectivoReal, notes } = req.body; +    db.get("SELECT * FROM turnos WHERE id = ?", [id], (err, turno) => { +        if (!turno) return res.status(404).json({ error: "Turno no encontrado" }); +        const discrepancia = saldoEfectivoReal - turno.saldoEfectivoTeorico; +        db.run(`UPDATE turnos SET fin = datetime('now', 'localtime'), estado = 'auditado',  +                saldoEfectivoReal = ?, discrepanciaEfectivo = ?, notes = ? WHERE id = ?`, +               [saldoEfectivoReal, discrepancia, notes, id], (err) => { +            if (err) return res.status(500).json({ error: err.message }); +            res.json({ success: true, discrepancia }); +        }); +    }); +}); + +app.get('/api/turnos', (req, res) => { +    db.all("SELECT * FROM turnos ORDER BY id DESC", [], (err, rows) => { +        res.json(rows || []); +    }); +}); + +// Registro de Ventas / Cobro de Deuda +app.post('/api/ventas', (req, res) => { +    const { sucursalId, turnoId, clienteId, total, metodoPago, items, estado } = req.body; +     +    db.serialize(() => { +        db.run("BEGIN TRANSACTION"); +         +        db.run(`INSERT INTO ventas (sucursalId, turnoId, fecha, clienteId, clienteNombre, total, metodoPago, estado)  +                VALUES (?, ?, datetime('now', 'localtime'), ?, (SELECT nombre FROM clientes WHERE id = ?), ?, ?, ?)`, +               [sucursalId, turnoId, clienteId, clienteId, total, metodoPago, estado || 'cobrado'], function(err) { +            if (err) { +                db.run("ROLLBACK"); +                return res.status(500).json({ error: err.message }); +            } +            const ventaId = this.lastID; +             +            const stmt = db.prepare("INSERT INTO venta_items (ventaId, productoId, nombre, precio, cantidad) VALUES (?, ?, ?, ?, ?)"); +            items.forEach(item => { +                stmt.run(ventaId, item.productoId, item.nombre, item.precio, item.cantidad); +            }); +            stmt.finalize(); + +            // Afectar cuenta corriente si es fiado ('corriente') o abono ('cobro_deuda') +            if (metodoPago === 'corriente') { +                db.run("UPDATE clientes SET saldo = saldo - ? WHERE id = ?", [total, clienteId]); +            } else if (estado === 'cobro_deuda') { +                db.run("UPDATE clientes SET saldo = saldo + ? WHERE id = ?", [total, clienteId]); +            } + +            // Afectar saldo te├│rico de la caja del cajero +            if (metodoPago === 'efectivo') { +                db.run("UPDATE turnos SET saldoEfectivoTeorico = saldoEfectivoTeorico + ? WHERE id = ?", [total, turnoId]); +            } else if (metodoPago === 'virtual') { +                db.run("UPDATE turnos SET saldoVirtualTeorico = saldoVirtualTeorico + ? WHERE id = ?", [total, turnoId]); +            } else if (metodoPago === 'tarjeta') { +                db.run("UPDATE turnos SET saldoTarjetaTeorico = saldoTarjetaTeorico + ? WHERE id = ?", [total, turnoId]); +            } + +            db.run("COMMIT", (err) => { +                if (err) return res.status(500).json({ error: "Transaction commit failed" }); +                res.json({ success: true, ventaId }); +            }); +        }); +    }); +}); +  const PORT = process.env.PORT || 5000;  app.listen(PORT, () => {      console.log(`Servidor de cobro corriendo en http://localhost:${PORT}`);  });
